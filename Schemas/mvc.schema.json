{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agile.example.com/schemas/mvc.schema.json",
  "title": "Modelo MVC / N-capas",
  "description": "Estructura JSON para un modelo arquitectonico MVC o N-capas que genera scaffold de proyecto.",
  "type": "object",
  "properties": {
    "capas": {
      "type": "array",
      "minItems": 1,
      "description": "Lista de capas arquitectonicas. Alias: 'componentes'.",
      "items": {
        "$ref": "#/definitions/Capa"
      }
    },
    "componentes": {
      "type": "array",
      "minItems": 1,
      "description": "Alias de 'capas'. Se acepta cualquiera de los dos.",
      "items": {
        "$ref": "#/definitions/Capa"
      }
    }
  },
  "anyOf": [
    { "required": ["capas"] },
    { "required": ["componentes"] }
  ],
  "definitions": {
    "Capa": {
      "type": "object",
      "required": ["nombre"],
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre de la capa. Ejemplo: Controller, Service, Repository, Model, View",
          "pattern": "^[A-Z][a-zA-Z0-9]*$"
        },
        "clases": {
          "type": "array",
          "description": "Lista de clases que pertenecen a esta capa.",
          "items": {
            "$ref": "#/definitions/ClaseCapa"
          },
          "default": []
        }
      }
    },
    "ClaseCapa": {
      "type": "object",
      "required": ["nombre"],
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre de la clase en PascalCase. Ejemplo: UsuarioController",
          "pattern": "^[A-Z][a-zA-Z0-9]*$"
        },
        "tipo": {
          "type": "string",
          "description": "Tipo de clase.",
          "enum": ["class", "interface", "abstract"],
          "default": "class"
        }
      }
    }
  }
}
